APP_NAME="Studio API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Karachi
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Where the React site runs. Must match exactly — scheme, host and port —
# or the browser will block every request as a CORS failure.
FRONTEND_URL=http://localhost:5173
# FRONTEND_URL_ALT=http://localhost:4173

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database — XAMPP / Laragon defaults. Create the database first:
#   CREATE DATABASE studio CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=studio
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# Sanctum: hosts allowed to authenticate. Port numbers matter.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:4173,127.0.0.1:5173

# ---------------------------------------------------------------------------
# Mail
#
# Leave as `log` while developing — emails are written to
# storage/logs/laravel.log instead of being sent, so you can read them without
# configuring anything.
#
# For Gmail you must use an App Password (a normal account password will be
# rejected): Google Account → Security → 2-Step Verification → App passwords.
# ---------------------------------------------------------------------------
MAIL_MAILER=log
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=niazattari2641@gmail.com
# MAIL_PASSWORD="your-16-character-app-password"
# MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="niazattari2641@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=public
