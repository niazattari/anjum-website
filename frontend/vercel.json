{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "build": {
    "env": {
      "VITE_API_BASE_URL": "",
      "VITE_WEB3FORMS_KEY": ""
    }
  },
  "rewrites": [
    {
      "source": "/((?!assets/|brand/|projects/|logos/|favicon).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
